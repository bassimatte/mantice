# MANTICE Environment Variables
# ==============================
# Copy this to .env and fill in your tokens for local development

# GitHub Personal Access Token for preset sharing
# ------------------------------------------------
# Without this token, the "Share" button will show:
# "⚠️ Sharing disabled on local server"
#
# To enable sharing:
# 1. Go to: https://github.com/settings/tokens/new
# 2. Create a token with 'repo' scope (full control of repositories)
# 3. Paste it below (never commit this file!)
GITHUB_TOKEN=

# Freesound API Key (optional, for sample library features)
# ----------------------------------------------------------
# Get your API key at: https://freesound.org/apiv2/apply/
# Without this, sample-based granular presets won't work
FREESOUND_API_KEY=
